package units

add :: proc {
	rat_add,
}

sub :: proc {
	rat_sub,
}

mul :: proc {
	rat_mul,
}

div :: proc {
	rat_div,
}

eq :: proc {
	rat_eq,
	compound_units_equal,
}

ne :: proc {
	rat_ne,
}

lt :: proc {
	rat_lt,
}

le :: proc {
	rat_le,
}

gt :: proc {
	rat_gt,
}

ge :: proc {
	rat_ge,
}

cmp :: proc {
	rat_cmp,
}

is_one :: proc {
	rat_is_one,
}

is_zero :: proc {
	rat_is_zero,
}
