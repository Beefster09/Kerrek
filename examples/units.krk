unit type length;
unit type mass;
unit type time;
unit type angle;
unit type temperature;

unit type area = length^2;
unit type volume = length^3;
unit type speed = length per time;


unit meter: length {
	to kilometer: / 1000;
	to millimeter: * 1000;
	to centimeter: * 100;
}
unit m = meter;

unit kilometer: length;
unit km = kilometer;

unit centimeter: length;
unit cm = centimeter;

unit millimeter: length;
unit mm = millimeter;

unit foot: length {
	from meter: * 3.28084;
	to inch: * 12;
	to yard: / 3;
	to mile: / 5280;
	from football_field: * 120;
}
unit ft = foot;
unit inch: length;
unit yard: length;
unit mile: length;
unit football_field: length;


unit kilogram: mass;
unit kg = kilogram;

unit gram: mass {
	to kg: / 1000;
}

unit milligram: mass;
unit mg = milligram;


unit second: time;
unit s = second;

unit minute: time {
	to second: * 60;
}
unit hour: time {
	to minute: * 60;
}
unit day: time {
	to hour: * 24;
}

const PI = 3.14159265358979;

unit degrees: angle;
unit radians: angle {
	from degrees: * PI / 180;
}
unit turn: angle {
	to degrees: * 360;
}


unit kelvin: temperature;
unit celsius: temperature;
unit fahrenheit: temperature;

@pure
func celsius_to_kelvin(degrees: Decimal | #celsius) -> Decimal | #kelvin {
	return degrees + 273.15 reinterpret unit as #kelvin;
}

@pure
func kelvin_to_celsius(heat: Decimal | #kelvin) -> Decimal | #celsius {
	return heat - 273.15 reinterpret unit as #celsius;
}

@pure
func celsius_to_fahrenheit(degrees: Decimal | #celsius) -> Decimal | #fahrenheit {
	return 9 * degrees / 5 + 32 reinterpret unit as #fahrenheit;
}

@pure
func fahrenheit_to_celsius(degrees: Decimal | #fahrenheit) -> Decimal | #celsius {
	return (degrees - 32) * 5 / 9 reinterpret unit as #celsius;
}


unit newton = kg m per s^2;
unit joule = newton m;
unit watt = joule per s;
\\ unit calorie = 4.184 * joule;
\\ unit btu = 1055 * joule;


unit man;
unit count;

unit ratio = 1;


func how_long_to_complete(num_workers: Integer | man, blocks: Decimal | ratio)
	-> Decimal | day
{
	const city_block_len = 0.125 mile;
	const city_block = city_block_len * city_block_len;
	const work_per_square_mile = 100 man * 30 day / city_block;

	let square_miles = blocks * city_block;
	return work_per_square_mile * square_miles / num_workers;
}


func flapjacks_required(num_workers: Integer | man) -> Decimal | count
{
	let hunger = num_workers * 314.15 / 1 man;
	hunger = (hunger + 2.717) * true;

	let a: Integer = 5;
	let b = 8;
	let c = a // b;
	let d = a % b;

	a, b = b, a;

	return count * hunger / 200;
}

func main() {}
